# SPECTR environment variables. Copy to .env for local development; set the same names in Vercel.
# Public: these two are built into the browser bundle. They are safe to expose (row level security protects data).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Secret: server only, never exposed to the browser.
ANTHROPIC_API_KEY=your-anthropic-api-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional, server only. Defaults to VITE_SUPABASE_URL when not set.
SUPABASE_URL=https://your-project-ref.supabase.co
